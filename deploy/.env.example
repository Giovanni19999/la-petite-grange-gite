# Copy to deploy/.env and fill in. Never commit deploy/.env.
# Use letters and digits only in passwords (they are inserted in DATABASE_URL).

APP_ENV=production

MARIADB_DATABASE=gite
MARIADB_USER=gite
MARIADB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-me-too

# Local: ":80" and port 8000 on the host. Production: the domain name, HTTP_PORT=80
# (and publish 443 for HTTPS), SITE_HOSTS=the domain name.
SITE_ADDRESS=:80
HTTP_PORT=8000
SITE_HOSTS=localhost

# Email and SMS sending (F025): password of the SMTP account set on the "Envoi des messages"
# screen, and SMS provider (none | brevo) with its API key.
SMTP_PASSWORD=
SMS_PROVIDER=none
BREVO_API_KEY=
