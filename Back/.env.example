# Copy to .env and fill in. Never commit .env.

# dev | test | staging | production
APP_ENV=dev
BIND_ADDR=127.0.0.1:8080
# pretty | json
LOG_FORMAT=pretty
RUST_LOG=info,gite_api=debug

# Local MariaDB started with `docker compose up -d` (see docker-compose.yml)
MARIADB_DATABASE=gite
MARIADB_USER=gite
MARIADB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-me-too
MARIADB_PORT=3306

DATABASE_URL=mysql://gite:change-me@127.0.0.1:3306/gite
DATABASE_MAX_CONNECTIONS=10

# Admin sessions and login throttling (ADR-0011), optional.
# TRUST_PROXY_HEADERS=true only behind our reverse proxy (client IP from X-Forwarded-For).
SESSION_MAX_AGE_DAYS=30
SESSION_IDLE_DAYS=7
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15
TRUST_PROXY_HEADERS=false

# Media library (F003, ADR-0017), optional. In development the API serves the files itself;
# behind Caddy (production) keep SERVE_MEDIA_FILES=false.
MEDIA_DIR=./data/media
MEDIA_PUBLIC_URL=/uploads
SERVE_MEDIA_FILES=true
MEDIA_MAX_FILE_MB=20
MEDIA_MAX_FILES=20
MEDIA_MAX_MEGAPIXELS=50
MEDIA_WIDTHS=480,960,1440,1920
MEDIA_WEBP_QUALITY=80

# Email and SMS sending (F025, ADR-0019), optional. The server, sender and recipients are set
# on the "Envoi des messages" screen; only the secrets are here. In development, set the
# server to 127.0.0.1, port 1025, security "none" (Mailpit, see docker-compose.yml).
# SMTP_PASSWORD=
# SMTP_PASSWORD_FILE=/run/secrets/smtp_password
# none | brevo
SMS_PROVIDER=none
# BREVO_API_KEY=
# BREVO_API_KEY_FILE=/run/secrets/brevo_api_key
MESSAGE_WORKER_SECONDS=10
